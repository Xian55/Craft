# Deployment config for deploy_pi.cmd — copy to .env and edit.
# .env is gitignored; this example documents every knob.

# ssh target that hosts the docker container
PI_HOST=user@192.168.1.100

# staging directory on the target (server.js, Dockerfile, web/ are copied here)
PI_DIR=/home/user/craft

# host port the game is served on (container always listens on 8080)
PI_PORT=8080
